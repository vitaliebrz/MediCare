# Copiază acest fișier în .env.local și completează valorile (Supabase → Project Settings).
# .env.local NU se pune pe GitHub (e în .gitignore). Pe Vercel, aceleași variabile se pun în
# Project → Settings → Environment Variables.

# Supabase → Project Settings → API (publice: ajung și în browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API → service_role. SECRETĂ: doar pe server (logo-ul clinicii în Storage).
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Connect → Transaction pooler (portul 6543). Folosită de aplicație.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PAROLA@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Supabase → Connect → Session pooler / Direct (portul 5432). Doar pentru `npm run db:push`, nu și pe Vercel.
DIRECT_URL=postgresql://postgres.xxxxxxxx:PAROLA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
